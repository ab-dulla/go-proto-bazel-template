"""
Root MODULE.bazel file for the Go monorepo.
"""

module(
    name = "go-monorepo-template",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.5.0")
bazel_dep(name = "rules_go", version = "0.45.1")
bazel_dep(name = "rules_proto", version = "6.0.0-rc1")
bazel_dep(name = "rules_pkg", version = "0.10.1")
bazel_dep(name = "rules_docker", version = "0.26.0")
bazel_dep(name = "gazelle", version = "0.35.0")
bazel_dep(name = "rules_lint", version = "0.20.0")
bazel_dep(name = "rules_kustomize", version = "0.8.1")
bazel_dep(name = "rules_helm", version = "0.5.1")

# Go Dependencies
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

go_deps.from_file(go_mod = "//:go.mod")

use_repo(
    go_deps,
    "com_github_envoyproxy_protoc_gen_validate",
    "com_github_grpc_ecosystem_grpc_gateway_v2",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "gorm_io_gorm",
    "gorm_io_driver_postgres",
    "com_github_stretchr_testify",
)

# rules_lint setup
use_repo(go_deps, golangci_lint = "com_github_golangci_golangci_lint")

lint = use_extension("@rules_lint//lint:extensions.bzl", "lint")

lint.toolchain(
    name = "golangci_lint_toolchain",
    linter = "@golangci_lint//:binary",
)

# rules_kustomize setup
kustomize = use_extension("@rules_kustomize//kustomize:extensions.bzl", "kustomize")
kustomize.toolchain(version = "v5.3.0")

# rules_helm setup
helm = use_extension("@rules_helm//helm:extensions.bzl", "helm")
helm.toolchain(version = "v3.14.2")

# rules_docker setup for distroless base image
oci = use_extension("@rules_pkg//pkg:oci.bzl", "oci")
oci.pull(
    name = "distroless_base",
    image = "gcr.io/distroless/base-debian12",
    # The digest for the specific image version we want to use.
    # This ensures hermetic builds.
    digest = "sha256:e36c4b931a5905c13b659a8145e61a2931267425f1784d7b4274916a04a6256f",
)
