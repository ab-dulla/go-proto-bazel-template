"""
BUILD file for the Product API service.
"""

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_docker//go:image.bzl", "go_image")
load("@rules_docker//container:container.bzl", "container_push")

go_library(
    name = "product_api_lib",
    srcs = ["main.go"],
    importpath = "go-monorepo-template/services/product-api",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/database",
        "//pkg/logger",
        "//proto/acme/product/v1:product_v1_go_grpc",
        "@org_golang_google_grpc//:grpc",
        "@gorm_io_gorm//:gorm",
    ],
)

go_binary(
    name = "product-api",
    embed = [":product_api_lib"],
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    embed = [":product-api"],
    base = "@distroless_base",
    cgo = True,
    visibility = ["//visibility:public"],
)

container_push(
    name = "push",
    format = "Docker",
    image = ":image",
    registry = "harbor.example.com",
    repository = "my-project/product-api",
    tag = "latest",
)
