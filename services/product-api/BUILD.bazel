"""
BUILD file for the Product API service.
"""

load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "product_api_lib",
    srcs = ["main.go"],
    importpath = "go-monorepo-template/services/product-api",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/database",
        "//pkg/logger",
        "//proto/acme/product/v1:product",
        "@io_gorm_gorm//:go_default_library",
        "@org_golang_google_grpc//:grpc",
    ],
)

go_binary(
    name = "product-api",
    embed = [":product_api_lib"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "app_layer",
    srcs = [":product-api"],
    mode = "0755",
    package_dir = "app",
)

oci_image(
    name = "image",
    base = "@distroless_base",
    entrypoint = ["/app/product-api"],
    tars = [":app_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    repository = "harbor.example.com/my-project/product-api:latest",
)
