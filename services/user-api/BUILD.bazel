"""
BUILD file for the User API service.
"""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "user_api_lib",
    srcs = ["main.go"],
    importpath = "go-monorepo-template/services/user-api",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/database",
        "//pkg/logger",
        "//proto/acme/user/v1:user",
        "@io_gorm_gorm//:go_default_library",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

go_binary(
    name = "user-api",
    embed = [":user_api_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "user_api_test",
    srcs = ["user_api_test.go"],
    embed = [":user_api_lib"],
    deps = [
        "//proto/acme/user/v1:user_v1_go_grpc",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "openapi_spec",
    srcs = ["//proto/acme/user/v1:user_v1.swagger.json"],
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "app_layer",
    srcs = [
        ":openapi_spec",
        ":user-api",
    ],
    mode = "0755",
    package_dir = "app",
)

oci_image(
    name = "image",
    base = "@distroless_base",
    entrypoint = ["/app/user-api"],
    tars = [":app_layer"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    # Tag is supplied externally (e.g., via --define oci_tag=...). Repository must not contain a tag.
    repository = "harbor.example.com/my-project/user-api",
)
