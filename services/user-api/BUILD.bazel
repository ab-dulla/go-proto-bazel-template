"""
BUILD file for the User API service.
"""

load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_docker//go:image.bzl", "go_image")
load("@rules_docker//container:container.bzl", "container_push")

go_library(
    name = "user_api_lib",
    srcs = ["main.go"],
    importpath = "go-monorepo-template/services/user-api",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/database",
        "//pkg/logger",
        "//proto/acme/user/v1:user_v1_go_grpc",
        "//proto/acme/user/v1:user_v1_go_grpc_gateway",
        "@com_github_grpc_ecosystem_grpc_gateway_v2//runtime",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@gorm_io_gorm//:gorm",
    ],
)

go_binary(
    name = "user-api",
    embed = [":user_api_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "user_api_test",
    srcs = ["user_api_test.go"],
    embed = [":user_api_lib"],
    deps = [
        "//proto/acme/user/v1:user_v1_go_grpc",
        "@com_github_stretchr_testify//assert",
    ],
)

filegroup(
    name = "openapi_spec",
    srcs = ["//proto/acme/user/v1:user_v1.swagger.json"],
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    embed = [":user-api"],
    # GORM requires CGO for Postgres SSL, so we use a base image with C libraries.
    # See: https://gorm.io/docs/connecting_to_the_database.html#PostgreSQL
    base = "@distroless_base",
    cgo = True,
    visibility = ["//visibility:public"],
    data = [":openapi_spec"],
    # We must set the path for the data file to be relative to the service root
    # so that the main.go file can find it.
    remap_paths = {
        "proto/acme/user/v1/user_v1.swagger.json": "services/user-api/user_v1.swagger.json",
    },
)

container_push(
    name = "push",
    format = "Docker",
    image = ":image",
    registry = "harbor.example.com",
    repository = "my-project/user-api",
    tag = "latest",
)
