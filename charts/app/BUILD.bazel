"""
BUILD file for the base Helm chart.
"""

# Load public Helm macros from defs.bzl (re-exports private/helm.bzl definitions).
load("@rules_helm//helm:defs.bzl", "helm_chart")

helm_chart(
    name = "app_chart",
    chart = "Chart.yaml",
    # Include both YAML manifests and helper template definitions (*.tpl)
    templates = glob(["templates/*.yaml", "templates/*.tpl"]),
    values = "values.yaml",
    visibility = ["//visibility:public"],
)
